@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MenuMetrics · Restaurant analytics</title>
  <meta name="description" content="Turn POS data into practical decisions about menu margin, demand, staffing, inventory, and promotions." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=JetBrains+Mono:wght@500&family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet" />
  @* site.css is intentionally NOT loaded here: its .landing rule applies a purple gradient that conflicts with this page. *@
  <style>
    *{box-sizing:border-box}
    body{margin:0;background:#f6f1e7;color:#24201c;font-family:Manrope,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    :focus-visible{outline:2px solid #b9472b;outline-offset:3px}
    .page{min-height:100vh;display:grid;grid-template-rows:auto 1fr auto;max-width:1180px;margin:0 auto;padding:0 28px}
    .nav{display:flex;align-items:center;justify-content:space-between;padding:20px 0;border-bottom:1.5px solid #24201c}
    .logo{color:inherit;text-decoration:none;font:600 21px Fraunces,Georgia,serif}.logo span{color:#b9472b}
    .nav-links{display:flex;gap:18px;font-size:13px;font-weight:600}.nav-links a{color:#544a40}
    .hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:56px;align-items:center;padding:64px 0}
    .eyebrow{color:#8b7f72;font-size:13px;font-weight:600}
    h1{margin:12px 0 18px;font:600 clamp(40px,6vw,72px)/1.02 Fraunces,Georgia,serif;letter-spacing:-.02em}
    .lead{margin:0;max-width:520px;color:#544a40;font-size:17px;line-height:1.6}
    .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
    .btn{display:inline-flex;align-items:center;min-height:44px;padding:10px 18px;border:1px solid #24201c;border-radius:6px;background:#24201c;color:#fff;font-size:14px;font-weight:700;text-decoration:none}
    .btn:hover{background:#b9472b;border-color:#b9472b}
    .btn.outline{background:transparent;color:#24201c}.btn.outline:hover{background:transparent;color:#b9472b;border-color:#b9472b}
    .rail{position:relative;padding-top:22px;border-top:6px solid #8f877d}
    .tk{position:relative;margin:0 0 -6px;padding:16px 18px;background:#fffdf8;border:1px solid #e2d8c7;box-shadow:0 1px 0 #e2d8c7}
    .tk:nth-child(1){transform:rotate(-1.2deg)}.tk:nth-child(2){transform:rotate(.8deg);margin-left:24px}.tk:nth-child(3){transform:rotate(-.4deg);margin-left:8px}
    .tk b{display:block;font:600 16px Fraunces,Georgia,serif}.tk span{color:#544a40;font-size:13px}
    .tk i{float:right;font:500 11px "JetBrains Mono",monospace;font-style:normal;color:#b9472b}
    .demo{margin-top:24px;color:#8b7f72;font:12px "JetBrains Mono",ui-monospace,monospace}
    footer{padding:18px 0;border-top:1px solid #e2d8c7;color:#8b7f72;font-size:12px}
    @@media (max-width:820px){.hero{grid-template-columns:1fr;gap:36px;padding:40px 0}.nav-tagline{display:none}}
  </style>
</head>
<body>
<div class="page">
  <header class="nav">
    <a class="logo" asp-controller="Home" asp-action="Index">Menu<span>Metrics</span></a>
    <nav class="nav-links" aria-label="Account">
      <a asp-area="Identity" asp-page="/Account/Login">Sign in</a>
    </nav>
  </header>
  <main class="hero">
    <div>
      <span class="eyebrow">For owners and kitchen managers</span>
      <h1>Know what's working before Friday service.</h1>
      <p class="lead">Drop in your POS export and see which dishes pay their way, when the rush hits, and how many hands you'll need on the line.</p>
      <div class="actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
          <a class="btn" asp-controller="Dashboard" asp-action="Index">Go to the pass</a>
        }
        else
        {
          <a class="btn" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
          <a class="btn outline" asp-area="Identity" asp-page="/Account/Register">Create an account</a>
        }
      </div>
      @* Demo credentials: remove this block before deploying to production. *@
      <p class="demo">Demo: demo@menumetrics.app / Demo!12345</p>
    </div>
    <div class="rail" aria-label="What MenuMetrics covers">
      <div class="tk"><i>01</i><b>Menu lab</b><span>Which items earn their place on the menu.</span></div>
      <div class="tk"><i>02</i><b>Rush hours</b><span>Plan staff around your real busy periods.</span></div>
      <div class="tk"><i>03</i><b>Next two weeks</b><span>A forecast with honest ranges, not promises.</span></div>
    </div>
  </main>
  <footer>© @DateTime.Now.Year MenuMetrics</footer>
</div>
</body>
</html>
