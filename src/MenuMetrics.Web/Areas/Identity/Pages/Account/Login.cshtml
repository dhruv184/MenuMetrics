@page
@model LoginModel

@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Sign in";
}

@section Styles {
<style>
  body.mm-auth-layout{min-height:100vh;margin:0;background:#f6f1e7;color:#24201c;font-family:Manrope,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
  .mm-login{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);min-height:100vh}
  .mm-login-form{display:flex;flex-direction:column;padding:28px clamp(24px,6vw,88px)}
  .mm-login-mark{color:inherit;text-decoration:none;font:600 21px Fraunces,Georgia,serif}
  .mm-login-mark span{color:#b9472b}
  .mm-login-inner{width:100%;max-width:380px;margin:auto 0;padding:48px 0}
  .mm-login-inner h1{margin:0 0 8px;font:600 38px/1.08 Fraunces,Georgia,serif;letter-spacing:-.015em}
  .mm-login-inner .mm-lede{margin:0 0 30px;color:#544a40;font-size:15px}
  .mm-auth-form{display:grid;gap:18px}
  .mm-auth-field{display:grid;gap:6px}
  .mm-auth-field label{font-size:13px;font-weight:700}
  .mm-auth-input{width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #cfc3ae;border-radius:6px;background:#fffdf8;color:#24201c;font:500 15px Manrope,sans-serif}
  .mm-auth-input:focus{outline:0;border-color:#24201c;box-shadow:0 0 0 3px rgba(185,71,43,.18)}
  .mm-auth-field-error,.mm-auth-validation{color:#a33c22;font-size:13px;font-weight:600}
  .mm-auth-validation ul{margin:0;padding-left:18px}
  .mm-auth-validation:not(.validation-summary-valid){padding:10px 12px;border-left:3px solid #b9472b;background:#f6e3da}
  .mm-auth-validation.validation-summary-valid,.mm-auth-validation:empty{display:none}
  .mm-auth-options{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px}
  .mm-auth-remember{display:flex;align-items:center;gap:8px;color:#544a40;cursor:pointer}
  .mm-auth-remember input{width:16px;height:16px;margin:0;accent-color:#24201c}
  .mm-login a{color:#24201c;font-weight:600;text-underline-offset:3px}
  .mm-login a:hover{color:#b9472b}
  .mm-auth-submit{min-height:46px;margin-top:4px;border:0;border-radius:6px;background:#24201c;color:#fff;font:700 15px Manrope,sans-serif;cursor:pointer}
  .mm-auth-submit:hover{background:#b9472b}
  .mm-auth-submit:focus-visible{outline:2px solid #b9472b;outline-offset:3px}
  .mm-auth-small{margin:0;color:#544a40;font-size:13px}
  .mm-auth-divider{display:flex;align-items:center;gap:12px;margin:24px 0 14px;color:#8b7f72;font-size:12px}
  .mm-auth-divider::before,.mm-auth-divider::after{content:"";flex:1;height:1px;background:#e2d8c7}
  .mm-auth-external{display:grid;gap:8px}
  .mm-auth-provider{min-height:42px;border:1px solid #cfc3ae;border-radius:6px;background:transparent;color:#24201c;font:600 14px Manrope,sans-serif;cursor:pointer}
  .mm-auth-provider:hover{border-color:#24201c}

  .mm-login-side{position:relative;display:flex;flex-direction:column;justify-content:center;padding:48px clamp(28px,5vw,72px);background:#2b2a26;color:#efe8db;overflow:hidden}
  .mm-rail{height:6px;margin-bottom:26px;border-radius:3px;background:#77706a}
  .mm-tk{position:relative;max-width:360px;padding:18px 20px;background:#fffdf8;color:#24201c;box-shadow:0 6px 18px rgba(0,0,0,.25)}
  .mm-tk::before{content:"";position:absolute;top:-14px;left:50%;width:12px;height:12px;margin-left:-6px;border-radius:50%;background:#b9b1a5}
  .mm-tk + .mm-tk{margin-top:-4px}
  .mm-tk.a{transform:rotate(-1.5deg)}
  .mm-tk.b{transform:rotate(1deg);margin-left:42px}
  .mm-tk-top{display:flex;justify-content:space-between;padding-bottom:8px;margin-bottom:10px;border-bottom:1px dashed #d6ccbb;font:500 11px "JetBrains Mono",monospace;color:#8b7f72}
  .mm-tk p{margin:0;font:600 17px/1.35 Fraunces,Georgia,serif}
  .mm-tk small{display:block;margin-top:6px;color:#544a40;font-size:12px}
  .mm-side-note{max-width:380px;margin:40px 0 0;color:#bfb6a8;font-size:14px;line-height:1.6}

  @@media (max-width:860px){
    .mm-login{grid-template-columns:1fr}
    .mm-login-side{display:none}
    .mm-login-inner{margin:0;padding:40px 0}
  }
</style>
}

<div class="mm-login">
    <section class="mm-login-form" aria-labelledby="login-heading">
        <a class="mm-login-mark" href="/">Menu<span>Metrics</span></a>

        <div class="mm-login-inner">
            <h1 id="login-heading">Good to see you again.</h1>
            <p class="mm-lede">Sign in to check last night's numbers.</p>

            <form id="account" method="post" class="mm-auth-form">
                <div asp-validation-summary="ModelOnly" class="mm-auth-validation" role="alert"></div>

                <div class="mm-auth-field">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email"
                           class="form-control mm-auth-input"
                           type="email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="you@restaurant.com" />
                    <span asp-validation-for="Input.Email" class="mm-auth-field-error"></span>
                </div>

                <div class="mm-auth-field">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password"
                           class="form-control mm-auth-input"
                           autocomplete="current-password"
                           aria-required="true" />
                    <span asp-validation-for="Input.Password" class="mm-auth-field-error"></span>
                </div>

                <div class="mm-auth-options">
                    <label asp-for="Input.RememberMe" class="mm-auth-remember">
                        <input asp-for="Input.RememberMe" />
                        <span>Keep me signed in</span>
                    </label>
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                </div>

                <button id="login-submit" type="submit" class="mm-auth-submit">Sign in</button>

                <p class="mm-auth-small">
                    No account yet?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
                    &middot;
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend confirmation email</a>
                </p>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="mm-auth-divider">or</div>
                <form id="external-account"
                      asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post"
                      class="mm-auth-external">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit"
                                class="mm-auth-provider"
                                name="provider"
                                value="@provider.Name"
                                title="Sign in using your @provider.DisplayName account">
                            Continue with @provider.DisplayName
                        </button>
                    }
                </form>
            }
        </div>
    </section>

    <aside class="mm-login-side" aria-hidden="true">
        <div class="mm-rail"></div>
        <div class="mm-tk a">
            <div class="mm-tk-top"><span>MENU LAB</span><span>#014</span></div>
            <p>Your burger sells twice as often as the risotto, and earns less per plate.</p>
            <small>Worth a look at portion cost.</small>
        </div>
        <div class="mm-tk b">
            <div class="mm-tk-top"><span>THE PASS</span><span>#015</span></div>
            <p>Saturday dinner peaks around 7:40. Two more on the line from 7.</p>
            <small>Based on the last six Saturdays.</small>
        </div>
        <p class="mm-side-note">Example notes only. Your own will come from the sales files you upload.</p>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
